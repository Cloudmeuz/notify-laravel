{
    "name": "cloudme/notify-laravel",
    "description": "Laravel integration for the Notify multi-channel notification API (SMS, Telegram, WhatsApp, Voice, Email, Push) - built on top of cloudme/notify-php.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "notify", "sms", "telegram", "whatsapp", "push", "email", "voice", "notifications", "api"],
    "require": {
        "php": "^8.2",
        "cloudme/notify-php": "^1.3",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/notifications": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "CloudMe\\NotifyLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CloudMe\\NotifyLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CloudMe\\NotifyLaravel\\NotifyServiceProvider"
            ],
            "aliases": {
                "Notify": "CloudMe\\NotifyLaravel\\Facades\\Notify"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
    
}
